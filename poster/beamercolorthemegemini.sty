% Minimal Gemini-inspired colour theme for the local PPMI poster.
\ProvidesPackage{beamercolorthemegemini}[2026/07/26 Gemini-inspired poster colours]

\RequirePackage{xcolor}

\definecolor{geminiBlue}{HTML}{0B3954}
\definecolor{geminiTeal}{HTML}{087E8B}
\definecolor{geminiLight}{HTML}{EAF4F7}
\definecolor{geminiText}{HTML}{1C1C1C}

\setbeamercolor{normal text}{fg=geminiText,bg=white}
\setbeamercolor{structure}{fg=geminiBlue}
\setbeamercolor{headline}{fg=white,bg=geminiBlue}
\setbeamercolor{title in headline}{fg=white}
\setbeamercolor{author in headline}{fg=white}
\setbeamercolor{institute in headline}{fg=white}
\setbeamercolor{block title}{fg=white,bg=geminiBlue}
\setbeamercolor{block body}{fg=geminiText,bg=geminiLight}
\setbeamercolor{footline}{fg=geminiBlue,bg=white}
\setbeamercolor{bibliography entry author}{fg=geminiText}
\setbeamercolor{bibliography entry title}{fg=geminiText}
\setbeamercolor{bibliography entry location}{fg=geminiText}
\setbeamercolor{bibliography entry note}{fg=geminiText}

\endinput
